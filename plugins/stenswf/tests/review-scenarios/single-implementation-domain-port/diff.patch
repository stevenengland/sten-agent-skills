@@ -0,0 +1,16 @@
+import Stripe from 'stripe'
+import type { PaymentGateway, PaymentResult } from './paymentGateway'
+
+export class StripePaymentGateway implements PaymentGateway {
+  constructor(private readonly stripe: Stripe) {}
+
+  async charge(orderId: string, amount: { cents: number; currency: 'eur' }): Promise<PaymentResult> {
+    const intent = await this.stripe.paymentIntents.create({
+      amount: amount.cents,
+      currency: amount.currency,
+      metadata: { orderId },
+    })
+    if (intent.status === 'succeeded') return { kind: 'paid', reference: intent.id }
+    return { kind: 'declined', reason: intent.last_payment_error?.message ?? intent.status }
+  }
+}
