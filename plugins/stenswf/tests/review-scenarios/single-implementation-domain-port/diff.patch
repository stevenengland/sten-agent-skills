+export type PaymentResult =
+  | { kind: 'paid'; reference: string }
+  | { kind: 'declined'; reason: string }
+
+/** Order code depends on this port; no Stripe type crosses it. */
+export interface PaymentGateway {
+  charge(orderId: string, amount: { cents: number; currency: 'eur' }): Promise<PaymentResult>
+}
