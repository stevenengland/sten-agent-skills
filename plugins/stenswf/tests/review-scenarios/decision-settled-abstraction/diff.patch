@@ -0,0 +1,8 @@
+import { db } from '../db'
+import type { AuditEvent, AuditLog } from './auditLog'
+
+export class PostgresAuditLog implements AuditLog {
+  async record(event: AuditEvent): Promise<void> {
+    await db.query('INSERT INTO audit (actor, action, subject) VALUES ($1, $2, $3)', [event.actor, event.action, event.subject])
+  }
+}
